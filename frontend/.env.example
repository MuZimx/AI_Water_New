# 前端 API 地址
# 开发环境建议使用同源代理，保持为 /api，这样登录 cookie 能被浏览器正确带上
NEXT_PUBLIC_API_BASE_URL=/api

# Next.js 服务端转发到真实后端地址（仅开发/代理使用）
BACKEND_ORIGIN=http://localhost:3001

# 地图可选配置（按需启用）
# NEXT_PUBLIC_OFFLINE_TILE_URL=/tiles/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_STYLE=https://api.mapbox.com/styles/v1/mapbox/streets-v12?access_token={token}
# NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token
# NEXT_PUBLIC_TDT_KEY=your_tianditu_key
